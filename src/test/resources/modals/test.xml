<?xml version="1.0" encoding="UTF-8"?>
<modals xmlns="https://jda-boot.swiftbyte.de/schema/modals"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jda-boot.swiftbyte.de/schema/modals modals.xsd">
    <layout id="test_modal_layout" modal-class="de.swiftbyte.test.TestModal" title="${title} Modal">
        <label text="Confirmation" description="Confirm the selection">
            <checkbox-group id="confirmation" required="true">
                <option label="confirmation" value="confirmation"/>
            </checkbox-group>
        </label>
        <label text="Features" description="Select all applicable features">
            <checkbox-group id="features" required="true" min-values="1" max-values="2">
                <option label="Notifications" value="notifications" description="Enable notifications" default="true"/>
                <option label="Statistics" value="statistics" description="Enable statistics"/>
            </checkbox-group>
        </label>
        <label text="Theme" description="Select one theme">
            <radio-group id="theme">
                <option label="Light" value="light" description="Use the light theme"/>
                <option label="Dark" value="dark" description="Use the dark theme" default="true"/>
            </radio-group>
        </label>
        <label text="Media" description="Upload media or a PDF">
            <file-input id="media" required="false" max-values="3">
                <file-type value="image"/>
                <file-type value="video"/>
                <file-type value="audio"/>
                <file-type value="pdf"/>
            </file-input>
        </label>
        <label text="Any file">
            <file-input id="any-file" required="false"/>
        </label>
    </layout>
</modals>
